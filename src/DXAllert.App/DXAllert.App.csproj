<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Il suffisso windows10 serve alle notifiche toast -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Solo per l'icona nell'area di notifica (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>dxallert</AssemblyName>
    <RootNamespace>DXAllert.App</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.3</Version>
    <Product>DXAllert</Product>
    <Description>Avvisi DXpedition per radioamatori</Description>
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DXAllert.Core\DXAllert.Core.csproj" />
    <ProjectReference Include="..\DXAllert.Data\DXAllert.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
