<Window x:Class="DXAllert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding AppTitle}" Width="1280" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="app.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,2" />
        </Style>
        <Style x:Key="OnAirPill" TargetType="Border">
            <Setter Property="Background" Value="#E53935" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- Tabelle in stile DX cluster -->
        <FontFamily x:Key="SpotFont">Cascadia Mono, Consolas</FontFamily>
        <Style x:Key="CallPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="{StaticResource SpotFont}" />
        </Style>
        <!-- Nominativo in etichetta colorata: cliccandolo si apre la sua scheda su QRZ.com -->
        <Style x:Key="CallPillButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Apri la scheda su QRZ.com" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="7,2">
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}" Style="{StaticResource PillText}" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="TextDecorations" Value="Underline" />
                                <Setter TargetName="b" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2">
                            <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpotHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Background" Value="#2E3540" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,7" />
        </Style>
        <Style x:Key="ClusterGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="FontFamily" Value="{StaticResource SpotFont}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource SpotHeader}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Panel}" />
            <Setter Property="MinRowHeight" Value="32" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <!-- Celle condivise da On Air e Attive ora (SpotRow e DxRow hanno gli stessi nomi) -->
        <DataTemplate x:Key="DxCallCell">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding DxFlag, TargetNullValue={x:Null}}" Width="22" Height="15" Stretch="Uniform"
                       HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding Entity}" />
                <Button Grid.Column="1" Style="{StaticResource CallPillButton}" Background="#E0393E" Content="{Binding DxCall}"
                        Tag="{Binding DxCall}" Click="QrzCall_Click" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE77B;" Tag="{Binding DxCall}" Click="QrzCall_Click" ToolTip="Scheda su QRZ.com" />
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE774;" Tag="{Binding DxCall}" Click="HamQthCall_Click" ToolTip="Scheda su HamQTH" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SpotterCell">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding SpotterFlag, TargetNullValue={x:Null}}" Width="22" Height="15" Stretch="Uniform"
                       HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding SpotterCountry}" />
                <Button Grid.Column="1" Style="{StaticResource CallPillButton}" Background="#2E8B57" Content="{Binding Spotter}"
                        Tag="{Binding Spotter}" Click="QrzCall_Click" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE77B;" Tag="{Binding Spotter}" Click="QrzCall_Click" ToolTip="Scheda dello spotter su QRZ.com" />
            </Grid>
        </DataTemplate>


        <!-- Pannello dei dettagli della riga selezionata -->
        <DataTemplate x:Key="DxDetails">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Callsign}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding Entity}" FontSize="15" Margin="12,3,0,0" />
                            <TextBlock Margin="12,5,0,0" Foreground="{DynamicResource Muted}">
                                <Run Text="{Binding Continent, Mode=OneWay}" /><Run Text=" · CQ " /><Run Text="{Binding CqZone, Mode=OneWay}" /><Run Text=" · ITU " /><Run Text="{Binding ItuZone, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Iota, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="12,5,0,0" Foreground="{DynamicResource Muted}">
                                <Run Text="{Binding DistanceText, Mode=OneWay}" /><Run Text="  azimut " /><Run Text="{Binding AzimuthText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding Info}" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="70" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Muted}">
                            <Run Text="Fonti: " /><Run Text="{Binding Sources, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Button Content="Apri sito / QSL" Click="OpenLink_Click" Margin="0,0,0,6" />
                        <Button Content="Mostra sulla mappa" Click="ShowOnMap_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- Riquadro con la scheda QRZ.com del nominativo selezionato -->
        <DataTemplate x:Key="QrzPanelTemplate">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Apri su qrz.com" Click="OpenQrz_Click"
                                    VerticalAlignment="Center" Visibility="{Binding HasCall, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="QRZ.com" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" />
                        </DockPanel>
                        <TextBlock Text="{Binding Call}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Name}" FontSize="15" TextWrapping="Wrap" />
                        <Image Source="{Binding ImageUrl}" MaxHeight="210" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Warn}" />
                        <ItemsControl ItemsSource="{Binding Fields}" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5,0,0">
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Testata: titolo, stato del cluster, orologio UTC -->
        <Grid Margin="16,10,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding AppTitle}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding SpotStatus}" Margin="20,3,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <Button Content="Aggiorna adesso" Command="{Binding RefreshNowCommand}" Margin="0,0,8,0" />
                <Button Content="Tema chiaro/scuro" Command="{Binding ToggleThemeCommand}" Margin="0,0,8,0" />
                <Button Content="Apri log" Command="{Binding OpenLogCommand}" />
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding UtcClock}" FontSize="18" FontWeight="SemiBold" FontFamily="Consolas"
                       VerticalAlignment="Center" ToolTip="Ora UTC (ora locale tra parentesi)" />
        </Grid>

        <StackPanel Grid.Row="1">
            <!-- Versione nuova su GitHub -->
            <Border Background="#1FA055" Padding="16,6" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Aggiorna ora" Command="{Binding InstallUpdateCommand}" Margin="8,0,0,0" FontWeight="SemiBold"
                                />
                        <Button Content="Novità" Command="{Binding ShowUpdateNotesCommand}" Margin="8,0,0,0" />
                        <Button Content="Più tardi" Command="{Binding DismissUpdateCommand}" Margin="8,0,0,0" />
                        <Button Content="Salta questa versione" Command="{Binding SkipUpdateCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" Foreground="White" TextWrapping="Wrap">
                        <Run Text="{Binding UpdateText, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{Binding UpdateStatus, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <Border Background="{DynamicResource Sel}" Padding="16,8"
                    Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap"
                           Text="Benvenuto! Apri la scheda Impostazioni e inserisci il tuo nominativo e il tuo locator: servono per collegarsi al DX cluster e per calcolare distanza e azimut." />
            </Border>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="2" Foreground="{DynamicResource Fg}">
            <!-- ON AIR: tutti gli spot del cluster, con i dati delle DXpedition attive -->
            <TabItem Header="{Binding OnAirHeader}" x:Name="OnAirTab">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="330" MinWidth="180" MaxWidth="600" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,10,16,6">
                        <Border Style="{StaticResource OnAirPill}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="ON AIR" Foreground="White" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <TextBlock Text="{Binding OnAirSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,2,16,8">
                        <CheckBox Content="Mostra tutti gli spot (non solo le DXpedition attive)" IsChecked="{Binding ShowAllSpots}" />
                        <TextBlock Text="{Binding SpotStatus}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <!-- Filtri sugli spot -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,0,16,8">
                        <ComboBox ItemsSource="{Binding SpotBands}" SelectedIndex="{Binding SelectedSpotBand}" Width="140" Margin="0,0,8,0" ToolTip="Filtro per banda" />
                        <ComboBox ItemsSource="{Binding SpotModes}" SelectedIndex="{Binding SelectedSpotMode}" Width="130" Margin="0,0,8,0" ToolTip="Filtro per modo" />
                        <TextBlock Text="Frequenza da" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="{DynamicResource Muted}" />
                        <TextBox Text="{Binding SpotFreqFrom, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="In kHz (es. 14000) oppure in MHz (es. 14.0)" />
                        <TextBlock Text="a" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource Muted}" />
                        <TextBox Text="{Binding SpotFreqTo, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="In kHz (es. 14070) oppure in MHz (es. 14.07)" />
                        <TextBlock Text="kHz" VerticalAlignment="Center" Margin="6,0,12,0" Foreground="{DynamicResource Muted}" />
                        <Button Content="Azzera filtri" Command="{Binding ClearSpotFiltersCommand}" />
                        <TextBlock Text="{Binding SpotFilterMessage}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Warn}" />
                    </StackPanel>
                    <!-- Dettagli della DXpedition dello spot selezionato -->
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding SelectedSpot.Dx}" ContentTemplate="{StaticResource DxDetails}" Focusable="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSpot.Dx}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <DataGrid ItemsSource="{Binding SpotsView}" SelectedItem="{Binding SelectedSpot}" Style="{StaticResource ClusterGrid}"
                              MouseDoubleClick="Grid_DoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDxpedition}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="ORA UTC" SortMemberPath="Spot.TimeUtc" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeShort}" Foreground="{DynamicResource Muted}" ToolTip="{Binding Time}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="★" Binding="{Binding FavoriteMark}" Width="30" />
                            <DataGridTemplateColumn Header="BANDA" SortMemberPath="Band" Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE71C;"
                                                    ToolTip="Mostra solo questa banda"
                                                    Command="{Binding DataContext.FilterBandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Band}" />
                                            <TextBlock Text="{Binding Band}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FREQUENZA" Binding="{Binding Freq}" SortMemberPath="Spot.FreqKhz" Width="96" />
                            <DataGridTemplateColumn Header="NOMINATIVO DX" SortMemberPath="DxCall" Width="226" CellTemplate="{StaticResource DxCallCell}" />
                            <DataGridTextColumn Header="PAESE" Binding="{Binding DxCountry}" SortMemberPath="Entity" Width="210" />
                            <DataGridTextColumn Header="DXCC" Binding="{Binding DxCode}" Width="76" />
                            <DataGridTextColumn Header="MODO" Binding="{Binding Mode}" Width="58" />
                            <DataGridTemplateColumn Header="SPOTTER" SortMemberPath="Spotter" Width="176" CellTemplate="{StaticResource SpotterCell}" />
                            <DataGridTextColumn Header="PAESE SPOTTER" Binding="{Binding SpotterCountry}" Width="190" />
                            <DataGridTextColumn Header="DXCC SPOTTER" Binding="{Binding SpotterCode}" Width="110" />
                            <DataGridTextColumn Header="COMMENTO" Binding="{Binding Comment}" Width="230" />
                            <DataGridTextColumn Header="GIÀ COLLEGATA" Binding="{Binding WorkedText}" Width="150" />
                            <DataGridTextColumn Header="RIMANGONO" Binding="{Binding DaysLeftText}" SortMemberPath="DaysLeft" Width="120" />
                            <DataGridTextColumn Header="QSL VIA" Binding="{Binding Qsl}" Width="130" />
                            <DataGridTextColumn Header="DISTANZA" Binding="{Binding DistanceText}" SortMemberPath="DistanceKm" Width="100" />
                            <DataGridTextColumn Header="AZIMUT" Binding="{Binding AzimuthText}" SortMemberPath="Azimuth" Width="70" />
                            <DataGridTemplateColumn Header="SITO" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource LinkButton}" Content="Apri" Click="OpenLink_Click" ToolTip="{Binding Dx.Url}"
                                                Visibility="{Binding IsDxpedition, Converter={StaticResource BoolToVis}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FONTE" Binding="{Binding Source}" Width="190" />
                        </DataGrid.Columns>
                    </DataGrid>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext" Background="{DynamicResource Line}" Cursor="SizeWE" />
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220" MinHeight="80" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <wv2:WebView2 x:Name="SpotMiniMap" Grid.Row="0" Loaded="MiniMap_Loaded" />
                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext" Background="{DynamicResource Line}" Cursor="SizeNS" />
                        <ContentControl Grid.Row="2" Content="{Binding Qrz}" ContentTemplate="{StaticResource QrzPanelTemplate}" Focusable="False" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ATTIVE ORA -->
            <TabItem Header="Attive ora">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="330" MinWidth="180" MaxWidth="600" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ActiveSummary}" Margin="16,10,16,8" Foreground="{DynamicResource Muted}" />
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding SelectedActive}" ContentTemplate="{StaticResource DxDetails}"
                                    Focusable="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedActive}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <DataGrid ItemsSource="{Binding Active}" SelectedItem="{Binding SelectedActive}" Style="{StaticResource ClusterGrid}"
                              MouseDoubleClick="Grid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="STATO" SortMemberPath="IsOnAir" Width="92">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource OnAirPill}" Visibility="{Binding IsOnAir, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Spottata negli ultimi 15 minuti">
                                            <TextBlock Text="ON AIR" Foreground="White" FontWeight="Bold" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="★" Binding="{Binding FavoriteMark}" Width="30" />
                            <DataGridTemplateColumn Header="NOMINATIVO DX" SortMemberPath="Callsign" Width="226" CellTemplate="{StaticResource DxCallCell}" />
                            <DataGridTextColumn Header="PAESE" Binding="{Binding DxCountry}" SortMemberPath="Entity" Width="210" />
                            <DataGridTextColumn Header="DXCC" Binding="{Binding DxCode}" Width="76" />
                            <DataGridTextColumn Header="GIÀ COLLEGATA" Binding="{Binding WorkedText}" Width="150" />
                            <DataGridTextColumn Header="INIZIO" Binding="{Binding StartText}" SortMemberPath="Start" Width="104" />
                            <DataGridTextColumn Header="FINE" Binding="{Binding EndText}" SortMemberPath="End" Width="104" />
                            <DataGridTextColumn Header="RIMANGONO" Binding="{Binding DaysLeftText}" SortMemberPath="DaysLeft" Width="120" />
                            <DataGridTextColumn Header="BANDE" Binding="{Binding Bands}" Width="90" />
                            <DataGridTextColumn Header="MODI" Binding="{Binding Modes}" Width="120" />
                            <DataGridTextColumn Header="ULTIMO SPOT" Binding="{Binding LastSpotText}" Width="290" />
                            <DataGridTextColumn Header="QSL VIA" Binding="{Binding Qsl}" Width="130" />
                            <DataGridTextColumn Header="DISTANZA" Binding="{Binding DistanceText}" SortMemberPath="DistanceKm" Width="100" />
                            <DataGridTextColumn Header="AZIMUT" Binding="{Binding AzimuthText}" SortMemberPath="Azimuth" Width="70" />
                            <DataGridTemplateColumn Header="SITO" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource LinkButton}" Content="Apri" Click="OpenLink_Click" ToolTip="{Binding Url}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FONTI" Binding="{Binding Sources}" Width="260" />
                        </DataGrid.Columns>
                    </DataGrid>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext" Background="{DynamicResource Line}" Cursor="SizeWE" />
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220" MinHeight="80" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <wv2:WebView2 x:Name="ActiveMiniMap" Grid.Row="0" Loaded="MiniMap_Loaded" />
                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext" Background="{DynamicResource Line}" Cursor="SizeNS" />
                        <ContentControl Grid.Row="2" Content="{Binding Qrz}" ContentTemplate="{StaticResource QrzPanelTemplate}" Focusable="False" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- PIANIFICATE -->
            <TabItem Header="Pianificate">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,8">
                        <CheckBox Content="Vista calendario" IsChecked="{Binding CalendarView}" Margin="0,0,20,0" />
                        <ComboBox ItemsSource="{Binding Months}" SelectedIndex="{Binding SelectedMonth}" Width="150" Margin="0,0,8,0" ToolTip="Filtro per mese">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CalendarView}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding Continents}" SelectedIndex="{Binding SelectedContinent}" Width="160" Margin="0,0,8,0" ToolTip="Filtro per continente" />
                        <TextBlock Text="Entità o nominativo:" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="{DynamicResource Muted}" />
                        <TextBox Text="{Binding EntityFilter, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                        <TextBlock Text="{Binding PlannedSummary}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Muted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CalendarView}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Grid>
                        <DockPanel>
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CalendarView}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <ContentControl DockPanel.Dock="Bottom" Content="{Binding SelectedPlanned}" ContentTemplate="{StaticResource DxDetails}"
                                            Focusable="False">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPlanned}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <DataGrid ItemsSource="{Binding Planned}" SelectedItem="{Binding SelectedPlanned}" BorderThickness="0,1,0,0"
                                      MouseDoubleClick="Grid_DoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="★" Binding="{Binding FavoriteMark}" Width="30" />
                                    <DataGridTextColumn Header="Nominativo" Binding="{Binding Callsign}" FontWeight="SemiBold" Width="110" />
                                    <DataGridTextColumn Header="Entità DXCC" Binding="{Binding Entity}" Width="180" />
                                    <DataGridTextColumn Header="Già collegata" Binding="{Binding WorkedText}" Width="150" />
                                    <DataGridTextColumn Header="Cont." Binding="{Binding Continent}" Width="50" />
                                    <DataGridTextColumn Header="Zona CQ" Binding="{Binding CqZone}" Width="66" />
                                    <DataGridTextColumn Header="Inizio" Binding="{Binding StartText}" SortMemberPath="Start" Width="98" />
                                    <DataGridTextColumn Header="Fine" Binding="{Binding EndText}" SortMemberPath="End" Width="98" />
                                    <DataGridTextColumn Header="Inizia" Binding="{Binding DaysToStartText}" SortMemberPath="DaysToStart" Width="100" />
                                    <DataGridTextColumn Header="Bande" Binding="{Binding Bands}" Width="80" />
                                    <DataGridTextColumn Header="Modi" Binding="{Binding Modes}" Width="110" />
                                    <DataGridTextColumn Header="IOTA" Binding="{Binding Iota}" Width="66" />
                                    <DataGridTextColumn Header="QSL via" Binding="{Binding Qsl}" Width="120" />
                                    <DataGridTextColumn Header="Distanza" Binding="{Binding DistanceText}" SortMemberPath="DistanceKm" Width="92" />
                                    <DataGridTemplateColumn Header="Link" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LinkButton}" Content="Apri" Click="OpenLink_Click" ToolTip="{Binding Url}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Fonti" Binding="{Binding Sources}" Width="*" MinWidth="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- Vista calendario: un mese, sei settimane da lunedì -->
                        <DockPanel Visibility="{Binding CalendarView, Converter={StaticResource BoolToVis}}">
                            <ContentControl DockPanel.Dock="Bottom" Content="{Binding SelectedDayEntry.Row}" ContentTemplate="{StaticResource DxDetails}"
                                            Focusable="False">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDayEntry}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="340" MinWidth="220" MaxWidth="600" />
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0" Margin="12,0,8,8">
                                    <!-- Mese e navigazione -->
                                    <DockPanel DockPanel.Dock="Top" Margin="3,0,3,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="‹" Command="{Binding PrevMonthCommand}" Width="34" Padding="0,2" FontSize="16" ToolTip="Mese precedente" />
                                            <Button Content="Oggi" Command="{Binding ThisMonthCommand}" Margin="6,0" />
                                            <Button Content="›" Command="{Binding NextMonthCommand}" Width="34" Padding="0,2" FontSize="16" ToolTip="Mese successivo" />
                                            <TextBlock Text="{Binding CalendarTitle}" FontSize="22" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CalendarSummary}" Foreground="{DynamicResource Muted}" Margin="14,4,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Legend}" HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="10,2,0,2">
                                                        <Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>

                                    <!-- Giorni della settimana -->
                                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding WeekDays}" Margin="0,0,0,2" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="9,0,0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Griglia del mese -->
                                    <ListBox ItemsSource="{Binding CalendarDays}" SelectedItem="{Binding SelectedDay}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="cell" Margin="3" CornerRadius="6" Padding="7,5" ClipToBounds="True"
                                                                    Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                                    <Setter TargetName="cell" Property="Background" Value="{DynamicResource PanelAlt}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                    <Setter TargetName="cell" Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="cell" Property="Background" Value="{DynamicResource Hover}" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                                    <Setter TargetName="cell" Property="BorderThickness" Value="2" />
                                                                    <Setter TargetName="cell" Property="Background" Value="{DynamicResource Sel}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <DockPanel DockPanel.Dock="Top">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveText}" FontSize="11" Foreground="{DynamicResource Muted}"
                                                                   VerticalAlignment="Center" />
                                                        <Border x:Name="num" CornerRadius="11" MinWidth="24" Height="22" Padding="5,0" HorizontalAlignment="Left">
                                                            <TextBlock x:Name="numText" Text="{Binding DayNumber}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </DockPanel>
                                                    <!-- Quante DXpedition sono attive, rispetto al giorno più pieno del mese -->
                                                    <Border DockPanel.Dock="Top" Height="3" CornerRadius="1.5" Margin="0,3,0,4" Background="{DynamicResource Line}">
                                                        <Border CornerRadius="1.5" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding Activity}" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding MoreText}" FontSize="11" Foreground="{DynamicResource Muted}" />
                                                    <ItemsControl ItemsSource="{Binding Starts}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding Color}" CornerRadius="3" Padding="5,1" Margin="0,1" ToolTip="{Binding Tip}">
                                                                    <TextBlock Text="{Binding Call}" Foreground="#10151A" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter TargetName="num" Property="Background" Value="{DynamicResource Accent}" />
                                                        <Setter TargetName="numText" Property="Foreground" Value="{DynamicResource AccentFg}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>

                                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              ResizeBehavior="PreviousAndNext" Background="{DynamicResource Line}" Cursor="SizeWE" />

                                <!-- Elenco del giorno selezionato -->
                                <DockPanel Grid.Column="2" Background="{DynamicResource Panel}">
                                    <StackPanel DockPanel.Dock="Top" Margin="14,10,14,8">
                                        <TextBlock Text="{Binding SelectedDayTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedDaySubtitle}" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding DayEntries}" SelectedItem="{Binding SelectedDayEntry}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}"
                                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             MouseDoubleClick="DayList_DoubleClick">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="b" Margin="8,2" CornerRadius="5" Background="Transparent">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Sel}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border CornerRadius="2" Background="{Binding Row.ContinentColor}" Margin="0,5" />
                                                    <StackPanel Grid.Column="1" Margin="10,6,8,6">
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Right" Background="{DynamicResource Accent}" CornerRadius="8" Padding="7,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="{DynamicResource AccentFg}" FontWeight="SemiBold" />
                                                            </Border>
                                                            <TextBlock>
                                                                <Run Text="{Binding Row.Callsign, Mode=OneWay}" FontSize="14" FontWeight="Bold" /><Run Text=" " /><Run Text="{Binding Row.FavoriteMark, Mode=OneWay}" Foreground="{DynamicResource Warn}" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Row.Entity}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Row.WorkedText}" FontSize="12" Foreground="{DynamicResource Accent}"
                                                                   Visibility="{Binding HasWorked, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- CONTEST: calendario dei contest italiani, europei e mondiali -->
            <TabItem Header="Contest">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,8">
                        <CheckBox Content="Vista calendario" IsChecked="{Binding ContestCalendarView}" Margin="0,0,20,0" />
                        <ComboBox ItemsSource="{Binding ContestRegions}" SelectedIndex="{Binding SelectedContestRegion}" Width="170" Margin="0,0,8,0"
                                  ToolTip="Filtro per area: chi organizza il contest" />
                        <TextBlock Text="Cerca (nome, modo, banda):" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="{DynamicResource Muted}" />
                        <TextBox Text="{Binding ContestFilter, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                        <TextBlock Text="{Binding ContestTableSummary}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Muted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ContestCalendarView}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="16,4,16,8" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12">
                        <Run Text="Date calcolate dalla regola abituale di ogni contest (Italia: regolamenti ARI 2026): controlla sempre il regolamento dell'anno." />
                        <Run Text="{Binding ContestSourceText, Mode=OneWay}" />
                    </TextBlock>
                    <!-- Dettagli del contest selezionato -->
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding SelectedContest}" Focusable="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedContest}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Apri il regolamento" Click="OpenContestRules_Click" VerticalAlignment="Center"
                                                Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="11" Height="11" Fill="{Binding RegionColor}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Region}" Foreground="{DynamicResource Muted}" Margin="12,4,0,0" />
                                            </StackPanel>
                                            <TextBlock Margin="0,4,0,0">
                                                <Run Text="{Binding Period, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding DurationText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding WhenText, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <TextBlock Foreground="{DynamicResource Muted}" Margin="0,2,0,0">
                                                <Run Text="{Binding Details, Mode=OneWay}" /><Run Text="  ·  Fonte: " /><Run Text="{Binding Source, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <Grid>
                        <!-- Vista tabella: i prossimi 12 mesi -->
                        <DataGrid ItemsSource="{Binding Contests}" SelectedItem="{Binding SelectedContest}">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource ClusterGrid}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ContestCalendarView}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="AREA" SortMemberPath="Region" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Fill="{Binding RegionColor}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding Region}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="CONTEST" Binding="{Binding Name}" Width="340" />
                                <DataGridTextColumn Header="INIZIO (UTC)" Binding="{Binding StartText}" SortMemberPath="Start" Width="170" />
                                <DataGridTextColumn Header="FINE (UTC)" Binding="{Binding EndText}" SortMemberPath="End" Width="170" />
                                <DataGridTextColumn Header="DURATA" Binding="{Binding DurationText}" Width="90" />
                                <DataGridTextColumn Header="QUANDO" Binding="{Binding WhenText}" SortMemberPath="Start" Width="120" />
                                <DataGridTextColumn Header="MODI" Binding="{Binding Modes}" Width="130" />
                                <DataGridTextColumn Header="BANDE" Binding="{Binding Bands}" Width="170" />
                                <DataGridTextColumn Header="FONTE" Binding="{Binding Source}" Width="200" />
                                <DataGridTemplateColumn Header="REGOLAMENTO" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LinkButton}" Content="Apri" Click="OpenContestRules_Click" ToolTip="{Binding Url}"
                                                    Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Vista calendario: un mese, sei settimane da lunedì -->
                        <Grid Visibility="{Binding ContestCalendarView, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="360" MinWidth="220" MaxWidth="620" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="12,0,8,8">
                                <DockPanel DockPanel.Dock="Top" Margin="3,0,3,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="‹" Command="{Binding PrevContestMonthCommand}" Width="34" Padding="0,2" FontSize="16" ToolTip="Mese precedente" />
                                        <Button Content="Oggi" Command="{Binding ThisContestMonthCommand}" Margin="6,0" />
                                        <Button Content="›" Command="{Binding NextContestMonthCommand}" Width="34" Padding="0,2" FontSize="16" ToolTip="Mese successivo" />
                                        <TextBlock Text="{Binding ContestTitle}" FontSize="22" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ContestSummary}" Foreground="{DynamicResource Muted}" Margin="14,4,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding ContestLegend}" HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="10,2,0,2">
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="5,0,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding WeekDays}" Margin="0,0,0,2" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="9,0,0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ListBox ItemsSource="{Binding ContestDays}" SelectedItem="{Binding SelectedContestDay}" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource Fg}"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="cell" Margin="3" CornerRadius="6" Padding="7,5" ClipToBounds="True"
                                                                Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                                <Setter TargetName="cell" Property="Background" Value="{DynamicResource PanelAlt}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                <Setter TargetName="cell" Property="Opacity" Value="0.45" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="cell" Property="Background" Value="{DynamicResource Hover}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                                <Setter TargetName="cell" Property="BorderThickness" Value="2" />
                                                                <Setter TargetName="cell" Property="Background" Value="{DynamicResource Sel}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,3">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                                    <Border x:Name="num" CornerRadius="11" MinWidth="24" Height="22" Padding="5,0" HorizontalAlignment="Left">
                                                        <TextBlock x:Name="numText" Text="{Binding DayNumber}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding MoreText}" FontSize="11" Foreground="{DynamicResource Muted}" />
                                                <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding RegionColor}" CornerRadius="3" Padding="5,1" Margin="0,1">
                                                                <Border.ToolTip>
                                                                    <TextBlock>
                                                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" /><LineBreak /><Run Text="{Binding Period, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </Border.ToolTip>
                                                                <TextBlock Text="{Binding Name}" Foreground="#10151A" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="num" Property="Background" Value="{DynamicResource Accent}" />
                                                    <Setter TargetName="numText" Property="Foreground" Value="{DynamicResource AccentFg}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          ResizeBehavior="PreviousAndNext" Background="{DynamicResource Line}" Cursor="SizeWE" />

                            <!-- Contest del giorno selezionato -->
                            <DockPanel Grid.Column="2" Background="{DynamicResource Panel}">
                                <StackPanel DockPanel.Dock="Top" Margin="14,10,14,8">
                                    <TextBlock Text="{Binding ContestDayTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ContestDaySubtitle}" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding ContestDayRows}" SelectedItem="{Binding SelectedContest}" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource Fg}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="b" Margin="8,2" CornerRadius="5" Background="Transparent">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Sel}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="2" Background="{Binding RegionColor}" Margin="0,5" />
                                                <StackPanel Grid.Column="1" Margin="10,6,8,6">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Region}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Period}" FontSize="12" />
                                                    <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- CONTEE USA (diploma MARAC USA-CA) dal log ADIF -->
            <TabItem Header="Contee USA">
                <Grid>
                    <TextBlock x:Name="CountyMessage" Text="Caricamento della mappa…" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" />
                    <wv2:WebView2 x:Name="CountyMap" Loaded="CountyMap_Loaded" />
                </Grid>
            </TabItem>

            <!-- PREFETTURE GIAPPONESI (WAJA) e PROVINCE CINESI dal log ADIF -->
            <TabItem Header="Giappone">
                <Grid>
                    <TextBlock x:Name="JapanMessage" Text="Caricamento della mappa…" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" />
                    <wv2:WebView2 x:Name="JapanMap" Loaded="JapanMap_Loaded" />
                </Grid>
            </TabItem>
            <TabItem Header="Cina">
                <Grid>
                    <TextBlock x:Name="ChinaMessage" Text="Caricamento della mappa…" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" />
                    <wv2:WebView2 x:Name="ChinaMap" Loaded="ChinaMap_Loaded" />
                </Grid>
            </TabItem>

            <!-- MAPPA -->
            <TabItem Header="Mappa" x:Name="MapTab">
                <Grid>
                    <TextBlock x:Name="MapMessage" Text="Caricamento della mappa…" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" />
                    <wv2:WebView2 x:Name="Map" Loaded="Map_Loaded" />
                </Grid>
            </TabItem>

            <!-- IMPOSTAZIONI -->
            <TabItem Header="Impostazioni" x:Name="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,6,24,24" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="La mia stazione" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Nominativo" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding EditCallsign, UpdateSourceTrigger=PropertyChanged}" Width="160" CharacterCasing="Upper" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Locator (es. JN55 o JN55ab)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding EditLocator, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="DX cluster" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Nodi telnet, uno per riga nella forma host:porta. Vengono collegati tutti insieme; gli spot doppi sono scartati." Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding EditClusterNodes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="76" Width="420"
                                 HorizontalAlignment="Left" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Foreground="{DynamicResource Muted}" Margin="0,6,0,4" TextWrapping="Wrap"
                                   Text="Nodi verificati: iq8do.aricaserta.it porta 7300 · dxc.ve7cc.net porta 23 · dxspider.co.uk porta 7300 · dxfun.com porta 8000" />
                        <CheckBox Content="Se il cluster non risponde usa la riserva web (DXSummit)" IsChecked="{Binding EditWebFallback}" />

                        <TextBlock Text="Bande che mi interessano" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding BandChecks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Modi che mi interessano" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding ModeChecks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="QRZ.com" Style="{StaticResource SectionTitle}" />
                        <TextBlock Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Con utente e password di QRZ.com il riquadro a destra di On Air e Attive ora mostra la scheda del nominativo selezionato. I dati completi richiedono un abbonamento XML di QRZ; senza, arrivano solo quelli di base." />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Utente QRZ (nominativo)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding EditQrzUser, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Password QRZ" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="QrzPassword" Width="200" Padding="6,4" PasswordChanged="QrzPassword_Changed"
                                             Background="{DynamicResource Panel}" Foreground="{DynamicResource Fg}"
                                             BorderBrush="{DynamicResource Line}" CaretBrush="{DynamicResource Fg}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding QrzPasswordHint}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />

                        <TextBlock Text="Log ADIF (già collegati)" Style="{StaticResource SectionTitle}" />
                        <TextBlock Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Importa il file ADIF esportato dal tuo programma di log: la colonna «Già collegata» mostra ✓ con bande e modi se hai già collegato quel nominativo, ~ se hai collegato solo la sua entità DXCC, vuoto se è nuova. La scheda Contee USA usa anche lo stato e la contea (campi STATE e CNTY): se hai importato il log con una versione precedente alla 1.0.9, importalo di nuovo. Ogni importazione sostituisce la precedente." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Importa file ADIF…" Click="ImportAdif_Click" Margin="0,0,8,0" />
                            <Button Content="Cancella il log importato" Command="{Binding ClearWorkedCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding WorkedStats}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="Preferiti" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Nominativi o entità DXCC, uno per riga (es. 3Y0L oppure Bouvet)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding EditFavorites, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="90" Width="420"
                                 HorizontalAlignment="Left" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="Avvisi" Style="{StaticResource SectionTitle}" />
                        <TextBlock Foreground="{DynamicResource Muted}" Margin="0,4,0,4" TextWrapping="Wrap"
                                   Text="L'avviso compare una sola volta, quando una DXpedition attiva passa a ON AIR su una banda e un modo che ti interessano. Finché resta in aria non si ripete; torna se ricompare dopo più di 15 minuti senza spot." />
                        <CheckBox Content="Avvisami quando una DXpedition attiva compare ON AIR" IsChecked="{Binding EditAlertOnSpot}" />
                        <CheckBox Content="Solo se la stazione è tra i preferiti" IsChecked="{Binding EditAlertOnlyFavorites}" Margin="22,3,0,3" />
                        <CheckBox Content="Suono insieme alla notifica" IsChecked="{Binding EditAlertSound}" />

                        <TextBlock Text="Altro" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Mostra anche i nominativi speciali (special event) del calendario 425 DX News" IsChecked="{Binding EditIncludeSpecial}" />
                        <CheckBox Content="Tema scuro" IsChecked="{Binding EditDarkTheme}" />
                        <CheckBox Content="Avvia DXAllert con Windows (ridotto nell'area di notifica)" IsChecked="{Binding EditAutostart}" />

                        <TextBlock Text="Aggiornamenti" Style="{StaticResource SectionTitle}" />
                        <TextBlock Foreground="{DynamicResource Muted}" Margin="0,4,0,4" TextWrapping="Wrap"
                                   Text="DXAllert controlla le versioni pubblicate su GitHub (github.com/iu2bnl/DxAllert, sezione Releases). Se ce n'è una nuova compare una barra verde in alto: con «Aggiorna ora» scarica l'installer, ne verifica l'impronta, chiude il programma, installa e lo riapre." />
                        <CheckBox Content="Controlla gli aggiornamenti all'avvio e una volta al giorno" IsChecked="{Binding EditCheckUpdates}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Controlla adesso" Command="{Binding CheckUpdatesNowCommand}" />
                            <TextBlock Text="{Binding UpdateStatus}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Salva" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" MinWidth="110" />
                            <Button Content="Prova un avviso" Command="{Binding TestAlertCommand}" Margin="10,0,0,0" />
                            <Button Content="Apri la cartella dei log" Command="{Binding OpenLogFolderCommand}" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding SettingsMessage}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Warn}" />

                        <TextBlock Margin="0,26,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                   Text="Fonti dei dati: DXZone, 425 DX News, NG3K Announced DX Operations, DX-World. Spot: DX cluster e DXSummit. Entità DXCC: country-files.com (cty.dat, cty.csv); paese di ogni entità: dxcc-json di K0SWE (Apache 2.0). Bandiere: flagcdn.com. Mappa: stati e nomi da Natural Earth, dettagli © OpenStreetMap. Le liste si aggiornano ogni minuto." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Barra di stato -->
        <Border Grid.Row="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SourcesText}" Foreground="{DynamicResource Muted}" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
