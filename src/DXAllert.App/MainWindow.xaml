<Window x:Class="DXAllert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DXAllert" Width="1280" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="app.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,2" />
        </Style>
        <Style x:Key="OnAirPill" TargetType="Border">
            <Setter Property="Background" Value="#E53935" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- Pannello dei dettagli della riga selezionata -->
        <DataTemplate x:Key="DxDetails">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Callsign}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding Entity}" FontSize="15" Margin="12,3,0,0" />
                            <TextBlock Margin="12,5,0,0" Foreground="{DynamicResource Muted}">
                                <Run Text="{Binding Continent, Mode=OneWay}" /><Run Text=" · CQ " /><Run Text="{Binding CqZone, Mode=OneWay}" /><Run Text=" · ITU " /><Run Text="{Binding ItuZone, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Iota, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="12,5,0,0" Foreground="{DynamicResource Muted}">
                                <Run Text="{Binding DistanceText, Mode=OneWay}" /><Run Text="  azimut " /><Run Text="{Binding AzimuthText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding Info}" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="70" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Muted}">
                            <Run Text="Fonti: " /><Run Text="{Binding Sources, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Button Content="Apri sito / QSL" Click="OpenLink_Click" Margin="0,0,0,6" />
                        <Button Content="Mostra sulla mappa" Click="ShowOnMap_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- Riquadro con la scheda QRZ.com del nominativo selezionato -->
        <DataTemplate x:Key="QrzPanelTemplate">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Apri su qrz.com" Click="OpenQrz_Click"
                                    VerticalAlignment="Center" Visibility="{Binding HasCall, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="QRZ.com" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" />
                        </DockPanel>
                        <TextBlock Text="{Binding Call}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Name}" FontSize="15" TextWrapping="Wrap" />
                        <Image Source="{Binding ImageUrl}" MaxHeight="210" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Warn}" />
                        <ItemsControl ItemsSource="{Binding Fields}" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5,0,0">
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Testata: titolo, stato del cluster, orologio UTC -->
        <Grid Margin="16,10,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="DXAllert" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding SpotStatus}" Margin="20,3,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <Button Content="Aggiorna adesso" Command="{Binding RefreshNowCommand}" Margin="0,0,8,0" />
                <Button Content="Tema chiaro/scuro" Command="{Binding ToggleThemeCommand}" Margin="0,0,8,0" />
                <Button Content="Apri log" Command="{Binding OpenLogCommand}" />
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding UtcClock}" FontSize="18" FontWeight="SemiBold" FontFamily="Consolas"
                       VerticalAlignment="Center" ToolTip="Ora UTC (ora locale tra parentesi)" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Sel}" Padding="16,8"
                Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap"
                       Text="Benvenuto! Apri la scheda Impostazioni e inserisci il tuo nominativo e il tuo locator: servono per collegarsi al DX cluster e per calcolare distanza e azimut." />
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="2" Foreground="{DynamicResource Fg}">
            <!-- ATTIVE ORA -->
            <TabItem Header="Attive ora">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="330" MinWidth="180" MaxWidth="600" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ActiveSummary}" Margin="16,10,16,8" Foreground="{DynamicResource Muted}" />
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding SelectedActive}" ContentTemplate="{StaticResource DxDetails}"
                                    Focusable="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedActive}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <DataGrid ItemsSource="{Binding Active}" SelectedItem="{Binding SelectedActive}" BorderThickness="0,1,0,0"
                              MouseDoubleClick="Grid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Stato" SortMemberPath="IsOnAir" Width="92">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource OnAirPill}" Visibility="{Binding IsOnAir, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Spottata negli ultimi 15 minuti">
                                            <TextBlock Text="ON AIR" Foreground="White" FontWeight="Bold" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="★" Binding="{Binding FavoriteMark}" Width="30" />
                            <DataGridTextColumn Header="Nominativo" Binding="{Binding Callsign}" FontWeight="SemiBold" Width="110" />
                            <DataGridTextColumn Header="Entità DXCC" Binding="{Binding Entity}" Width="170" />
                            <DataGridTextColumn Header="Già collegata" Binding="{Binding WorkedText}" Width="150" />
                            <DataGridTextColumn Header="Cont." Binding="{Binding Continent}" Width="50" />
                            <DataGridTextColumn Header="Inizio" Binding="{Binding StartText}" SortMemberPath="Start" Width="98" />
                            <DataGridTextColumn Header="Fine" Binding="{Binding EndText}" SortMemberPath="End" Width="98" />
                            <DataGridTextColumn Header="Rimangono" Binding="{Binding DaysLeftText}" SortMemberPath="DaysLeft" Width="112" />
                            <DataGridTextColumn Header="Bande" Binding="{Binding Bands}" Width="80" />
                            <DataGridTextColumn Header="Modi" Binding="{Binding Modes}" Width="110" />
                            <DataGridTextColumn Header="Ultimo spot" Binding="{Binding LastSpotText}" Width="250" />
                            <DataGridTextColumn Header="QSL via" Binding="{Binding Qsl}" Width="120" />
                            <DataGridTextColumn Header="Distanza" Binding="{Binding DistanceText}" SortMemberPath="DistanceKm" Width="92" />
                            <DataGridTextColumn Header="Azimut" Binding="{Binding AzimuthText}" SortMemberPath="Azimuth" Width="62" />
                            <DataGridTemplateColumn Header="Link" Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource LinkButton}" Content="Apri" Click="OpenLink_Click" ToolTip="{Binding Url}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Fonti" Binding="{Binding Sources}" Width="*" MinWidth="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext" Background="{DynamicResource Line}" Cursor="SizeWE" />
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220" MinHeight="80" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <wv2:WebView2 x:Name="ActiveMiniMap" Grid.Row="0" Loaded="ActiveMiniMap_Loaded" />
                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext" Background="{DynamicResource Line}" Cursor="SizeNS" />
                        <ContentControl Grid.Row="2" Content="{Binding Qrz}" ContentTemplate="{StaticResource QrzPanelTemplate}" Focusable="False" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TEMPO REALE -->
            <TabItem Header="Tempo reale">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="330" MinWidth="180" MaxWidth="600" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,8">
                        <CheckBox Content="Mostra tutti gli spot (non solo le DXpedition attive)" IsChecked="{Binding ShowAllSpots}" />
                        <TextBlock Text="{Binding SpotStatus}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <!-- Filtri sugli spot -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,0,16,8">
                        <ComboBox ItemsSource="{Binding SpotBands}" SelectedIndex="{Binding SelectedSpotBand}" Width="140" Margin="0,0,8,0" ToolTip="Filtro per banda" />
                        <ComboBox ItemsSource="{Binding SpotModes}" SelectedIndex="{Binding SelectedSpotMode}" Width="130" Margin="0,0,8,0" ToolTip="Filtro per modo" />
                        <TextBlock Text="Frequenza da" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="{DynamicResource Muted}" />
                        <TextBox Text="{Binding SpotFreqFrom, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="In kHz (es. 14000) oppure in MHz (es. 14.0)" />
                        <TextBlock Text="a" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource Muted}" />
                        <TextBox Text="{Binding SpotFreqTo, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="In kHz (es. 14070) oppure in MHz (es. 14.07)" />
                        <TextBlock Text="kHz" VerticalAlignment="Center" Margin="6,0,12,0" Foreground="{DynamicResource Muted}" />
                        <Button Content="Azzera filtri" Command="{Binding ClearSpotFiltersCommand}" />
                        <TextBlock Text="{Binding SpotFilterMessage}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Warn}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding SpotsView}" SelectedItem="{Binding SelectedSpot}" BorderThickness="0,1,0,0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDxpedition}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ora UTC (locale)" Binding="{Binding Time}" Width="140" />
                            <DataGridTextColumn Header="Nominativo" Binding="{Binding DxCall}" Width="120" />
                            <DataGridTextColumn Header="Entità" Binding="{Binding Entity}" Width="160" />
                            <DataGridTextColumn Header="Già collegata" Binding="{Binding WorkedText}" Width="150" />
                            <DataGridTextColumn Header="Frequenza kHz" Binding="{Binding Freq}" Width="110" />
                            <DataGridTextColumn Header="Banda" Binding="{Binding Band}" Width="60" />
                            <DataGridTextColumn Header="Modo" Binding="{Binding Mode}" Width="60" />
                            <DataGridTextColumn Header="Spotter" Binding="{Binding Spotter}" Width="110" />
                            <DataGridTextColumn Header="Commento" Binding="{Binding Comment}" Width="*" />
                            <DataGridTextColumn Header="Fonte" Binding="{Binding Source}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext" Background="{DynamicResource Line}" Cursor="SizeWE" />
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220" MinHeight="80" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <wv2:WebView2 x:Name="SpotMiniMap" Grid.Row="0" Loaded="SpotMiniMap_Loaded" />
                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext" Background="{DynamicResource Line}" Cursor="SizeNS" />
                        <ContentControl Grid.Row="2" Content="{Binding Qrz}" ContentTemplate="{StaticResource QrzPanelTemplate}" Focusable="False" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- PIANIFICATE -->
            <TabItem Header="Pianificate">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,8">
                        <ComboBox ItemsSource="{Binding Months}" SelectedIndex="{Binding SelectedMonth}" Width="150" Margin="0,0,8,0" ToolTip="Filtro per mese" />
                        <ComboBox ItemsSource="{Binding Continents}" SelectedIndex="{Binding SelectedContinent}" Width="160" Margin="0,0,8,0" ToolTip="Filtro per continente" />
                        <TextBlock Text="Entità o nominativo:" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="{DynamicResource Muted}" />
                        <TextBox Text="{Binding EntityFilter, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                        <CheckBox Content="Vista calendario" IsChecked="{Binding CalendarView}" Margin="20,0,0,0" />
                        <TextBlock Text="{Binding PlannedSummary}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                    <Grid>
                        <DockPanel>
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CalendarView}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <ContentControl DockPanel.Dock="Bottom" Content="{Binding SelectedPlanned}" ContentTemplate="{StaticResource DxDetails}"
                                            Focusable="False">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPlanned}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <DataGrid ItemsSource="{Binding Planned}" SelectedItem="{Binding SelectedPlanned}" BorderThickness="0,1,0,0"
                                      MouseDoubleClick="Grid_DoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="★" Binding="{Binding FavoriteMark}" Width="30" />
                                    <DataGridTextColumn Header="Nominativo" Binding="{Binding Callsign}" FontWeight="SemiBold" Width="110" />
                                    <DataGridTextColumn Header="Entità DXCC" Binding="{Binding Entity}" Width="180" />
                                    <DataGridTextColumn Header="Già collegata" Binding="{Binding WorkedText}" Width="150" />
                                    <DataGridTextColumn Header="Cont." Binding="{Binding Continent}" Width="50" />
                                    <DataGridTextColumn Header="Zona CQ" Binding="{Binding CqZone}" Width="66" />
                                    <DataGridTextColumn Header="Inizio" Binding="{Binding StartText}" SortMemberPath="Start" Width="98" />
                                    <DataGridTextColumn Header="Fine" Binding="{Binding EndText}" SortMemberPath="End" Width="98" />
                                    <DataGridTextColumn Header="Inizia" Binding="{Binding DaysToStartText}" SortMemberPath="DaysToStart" Width="100" />
                                    <DataGridTextColumn Header="Bande" Binding="{Binding Bands}" Width="80" />
                                    <DataGridTextColumn Header="Modi" Binding="{Binding Modes}" Width="110" />
                                    <DataGridTextColumn Header="IOTA" Binding="{Binding Iota}" Width="66" />
                                    <DataGridTextColumn Header="QSL via" Binding="{Binding Qsl}" Width="120" />
                                    <DataGridTextColumn Header="Distanza" Binding="{Binding DistanceText}" SortMemberPath="DistanceKm" Width="92" />
                                    <DataGridTemplateColumn Header="Link" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LinkButton}" Content="Apri" Click="OpenLink_Click" ToolTip="{Binding Url}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Fonti" Binding="{Binding Sources}" Width="*" MinWidth="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- Vista calendario: i dodici mesi dell'anno in corso -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding CalendarView, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Calendar}" Margin="10,0,10,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="card" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                CornerRadius="6" Margin="6" Padding="12,8" MinHeight="90" Width="400" VerticalAlignment="Top">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource Muted}" />
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Lines}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                <Setter TargetName="card" Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- MAPPA -->
            <TabItem Header="Mappa" x:Name="MapTab">
                <Grid>
                    <TextBlock x:Name="MapMessage" Text="Caricamento della mappa…" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" />
                    <wv2:WebView2 x:Name="Map" Loaded="Map_Loaded" />
                </Grid>
            </TabItem>

            <!-- IMPOSTAZIONI -->
            <TabItem Header="Impostazioni" x:Name="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,6,24,24" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="La mia stazione" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Nominativo" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding EditCallsign, UpdateSourceTrigger=PropertyChanged}" Width="160" CharacterCasing="Upper" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Locator (es. JN55 o JN55ab)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding EditLocator, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="DX cluster" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Nodi telnet, uno per riga nella forma host:porta. Vengono collegati tutti insieme; gli spot doppi sono scartati." Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding EditClusterNodes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="76" Width="420"
                                 HorizontalAlignment="Left" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Foreground="{DynamicResource Muted}" Margin="0,6,0,4" TextWrapping="Wrap"
                                   Text="Nodi verificati: iq8do.aricaserta.it porta 7300 · dxc.ve7cc.net porta 23 · dxspider.co.uk porta 7300 · dxfun.com porta 8000" />
                        <CheckBox Content="Se il cluster non risponde usa la riserva web (DXSummit)" IsChecked="{Binding EditWebFallback}" />

                        <TextBlock Text="Bande che mi interessano" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding BandChecks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Modi che mi interessano" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding ModeChecks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="QRZ.com" Style="{StaticResource SectionTitle}" />
                        <TextBlock Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Con utente e password di QRZ.com il riquadro a destra di Attive ora e Tempo reale mostra la scheda del nominativo selezionato. I dati completi richiedono un abbonamento XML di QRZ; senza, arrivano solo quelli di base." />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Utente QRZ (nominativo)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding EditQrzUser, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Password QRZ" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="QrzPassword" Width="200" Padding="6,4" PasswordChanged="QrzPassword_Changed"
                                             Background="{DynamicResource Panel}" Foreground="{DynamicResource Fg}"
                                             BorderBrush="{DynamicResource Line}" CaretBrush="{DynamicResource Fg}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding QrzPasswordHint}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />

                        <TextBlock Text="Log ADIF (già collegati)" Style="{StaticResource SectionTitle}" />
                        <TextBlock Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Importa il file ADIF esportato dal tuo programma di log: la colonna «Già collegata» mostra ✓ con bande e modi se hai già collegato quel nominativo, ~ se hai collegato solo la sua entità DXCC, vuoto se è nuova. Ogni importazione sostituisce la precedente." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Importa file ADIF…" Click="ImportAdif_Click" Margin="0,0,8,0" />
                            <Button Content="Cancella il log importato" Command="{Binding ClearWorkedCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding WorkedStats}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="Preferiti" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Nominativi o entità DXCC, uno per riga (es. 3Y0L oppure Bouvet)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding EditFavorites, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="90" Width="420"
                                 HorizontalAlignment="Left" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="Avvisi" Style="{StaticResource SectionTitle}" />
                        <TextBlock Foreground="{DynamicResource Muted}" Margin="0,4,0,4" TextWrapping="Wrap"
                                   Text="L'avviso compare una sola volta, quando una DXpedition attiva passa a ON AIR su una banda e un modo che ti interessano. Finché resta in aria non si ripete; torna se ricompare dopo più di 15 minuti senza spot." />
                        <CheckBox Content="Avvisami quando una DXpedition attiva compare ON AIR" IsChecked="{Binding EditAlertOnSpot}" />
                        <CheckBox Content="Solo se la stazione è tra i preferiti" IsChecked="{Binding EditAlertOnlyFavorites}" Margin="22,3,0,3" />
                        <CheckBox Content="Suono insieme alla notifica" IsChecked="{Binding EditAlertSound}" />

                        <TextBlock Text="Altro" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Mostra anche i nominativi speciali (special event) del calendario 425 DX News" IsChecked="{Binding EditIncludeSpecial}" />
                        <CheckBox Content="Tema scuro" IsChecked="{Binding EditDarkTheme}" />
                        <CheckBox Content="Avvia DXAllert con Windows (ridotto nell'area di notifica)" IsChecked="{Binding EditAutostart}" />

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Salva" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" MinWidth="110" />
                            <Button Content="Prova un avviso" Command="{Binding TestAlertCommand}" Margin="10,0,0,0" />
                            <Button Content="Apri la cartella dei log" Command="{Binding OpenLogFolderCommand}" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding SettingsMessage}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Warn}" />

                        <TextBlock Margin="0,26,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                   Text="Fonti dei dati: DXZone, 425 DX News, NG3K Announced DX Operations, DX-World. Spot: DX cluster e DXSummit. Entità DXCC: country-files.com (cty.dat). Mappa © OpenStreetMap. Le liste si aggiornano ogni minuto." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Barra di stato -->
        <Border Grid.Row="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SourcesText}" Foreground="{DynamicResource Muted}" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
